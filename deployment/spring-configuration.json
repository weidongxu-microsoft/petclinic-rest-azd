{
  "spring": {
    "sql": {
      "init": {
        "mode": "never"
      }
    },
    "jpa": {
      "hibernate": {
        "ddl-auto": "none"
      }
    },
    "h2": {
      "console": {
        "enabled": false
      }
    },
    "datasource": {
      "hikari": {
        "maximum-pool-size": 5
      }
    }
  },
  "springdoc": {
    "api-docs": {
      "enabled": false
    },
    "swagger-ui": {
      "enabled": false
    }
  },
  "management": {
    "endpoints": {
      "web": {
        "exposure": {
          "include": "health"
        }
      }
    },
    "endpoint": {
      "health": {
        "show-details": "never"
      }
    }
  },
  "server": {
    "error": {
      "include-message": "never",
      "include-stacktrace": "never"
    },
    "forward-headers-strategy": "framework",
    "servlet": {
      "session": {
        "cookie": {
          "secure": true,
          "same-site": "strict"
        }
      }
    }
  }
}
